{
  "name": "@aicrm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "provision:user": "node --env-file=.env scripts/provision-user.mjs",
    "provision:dealership": "node --env-file=.env --env-file=../../packages/database/.env scripts/provision-dealership.mjs"
  },
  "dependencies": {
    "@aicrm/database": "workspace:*",
    "@aicrm/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "24.10.13",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.4",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
