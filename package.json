{
  "name": "ai-car-sales-crm",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @aicrm/database db:generate",
    "db:migrate": "pnpm --filter @aicrm/database db:migrate",
    "db:validate": "pnpm --filter @aicrm/database db:validate"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "2.11.13",
    "typescript-eslint": "8.73.0",
    "typescript": "5.9.3"
  }
}
