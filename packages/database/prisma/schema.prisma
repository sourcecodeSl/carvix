generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  DEALER_ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformAdministratorStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  users     User[]
  dealership Dealership?
  branches Branch[]
  memberships TenantMembership[]

  @@map("tenants")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String?    @map("tenant_id") @db.Uuid
  email     String
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships TenantMembership[]
  platformAdministrator PlatformAdministrator?
  passwordCredential PasswordCredential?
  authSessions AuthSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model PasswordCredential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  passwordHash     String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_credentials")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Dealership {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  businessName String   @map("business_name")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  country      String
  timezone     String
  currency     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("dealerships")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  dealershipId String       @map("dealership_id") @db.Uuid
  name         String
  code         String
  address      String?
  city         String?
  phone        String?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dealership   Dealership   @relation(fields: [dealershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([dealershipId, code])
  @@index([tenantId])
  @@index([dealershipId])
  @@map("branches")
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model PlatformAdministrator {
  id        String                      @id @default(uuid()) @db.Uuid
  userId    String                      @unique @map("user_id") @db.Uuid
  role      PlatformRole                @default(SUPER_ADMIN)
  status    PlatformAdministratorStatus @default(ACTIVE)
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("platform_administrators")
}
