generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  DEALER_ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformAdministratorStatus {
  ACTIVE
  SUSPENDED
}

enum AuditEventCategory {
  AUTHENTICATION
  AUTHORIZATION
  DEALERSHIP
  BRANCH
  STAFF
  INVITATION
  SECURITY
  SYSTEM
}

enum AuditEventOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum InventoryConnectionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ERROR
}

enum InventoryConnectorType {
  MYSQL
}

model AuditEvent {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String?             @map("tenant_id") @db.Uuid
  actorUserId      String?             @map("actor_user_id") @db.Uuid
  actorMembershipId String?            @map("actor_membership_id") @db.Uuid
  eventType        String              @map("event_type")
  category         AuditEventCategory
  action           String
  resourceType     String              @map("resource_type")
  resourceId       String?             @map("resource_id")
  outcome          AuditEventOutcome
  requestId        String?             @map("request_id")
  ipAddress        String?             @map("ip_address")
  userAgent        String?             @map("user_agent")
  metadata         Json?
  schemaVersion    Int                 @default(1) @map("schema_version")
  occurredAt       DateTime            @default(now()) @map("occurred_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc), id], map: "audit_events_tenant_occurred_id_idx")
  @@index([tenantId, eventType, occurredAt(sort: Desc)], map: "audit_events_tenant_event_occurred_idx")
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)], map: "audit_events_tenant_actor_occurred_idx")
  @@index([tenantId, category, outcome, occurredAt(sort: Desc)], map: "audit_events_tenant_category_outcome_idx")
  @@map("audit_events")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  users     User[]
  dealership Dealership?
  branches Branch[]
  memberships TenantMembership[]
  staffInvitations StaffInvitation[]
  auditEvents AuditEvent[]
  inventoryConnections InventoryConnection[]

  @@map("tenants")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String?    @map("tenant_id") @db.Uuid
  email     String
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships TenantMembership[]
  platformAdministrator PlatformAdministrator?
  passwordCredential PasswordCredential?
  authSessions AuthSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model PasswordCredential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  passwordHash     String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_credentials")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Dealership {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  businessName String   @map("business_name")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  country      String
  timezone     String
  currency     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]
  inventoryConnections InventoryConnection[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("dealerships")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  dealershipId String       @map("dealership_id") @db.Uuid
  name         String
  code         String
  address      String?
  city         String?
  phone        String?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dealership   Dealership   @relation(fields: [dealershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  staffAssignments      StaffBranchAssignment[]
  invitationAssignments StaffInvitationBranch[]

  @@unique([dealershipId, code])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([dealershipId])
  @@map("branches")
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchAssignments StaffBranchAssignment[]
  staffInvitations StaffInvitation[] @relation("StaffInvitationInviter")

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model StaffInvitation {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  invitedByMembershipId String                  @map("invited_by_membership_id") @db.Uuid
  email                 String
  role                  MembershipRole
  tokenHash             String                  @unique @map("token_hash") @db.Char(64)
  status                StaffInvitationStatus   @default(PENDING)
  expiresAt             DateTime                @map("expires_at")
  acceptedAt            DateTime?               @map("accepted_at")
  cancelledAt           DateTime?               @map("cancelled_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy             TenantMembership        @relation("StaffInvitationInviter", fields: [invitedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  branches              StaffInvitationBranch[]

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, email, status])
  @@map("staff_invitations")
}

model StaffInvitationBranch {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  invitationId String          @map("invitation_id") @db.Uuid
  branchId     String          @map("branch_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  invitation   StaffInvitation @relation(fields: [invitationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([invitationId, branchId])
  @@index([tenantId, branchId])
  @@map("staff_invitation_branches")
}

model StaffBranchAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  membership   TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([membershipId, branchId])
  @@index([tenantId, branchId])
  @@map("staff_branch_assignments")
}

model PlatformAdministrator {
  id        String                      @id @default(uuid()) @db.Uuid
  userId    String                      @unique @map("user_id") @db.Uuid
  role      PlatformRole                @default(SUPER_ADMIN)
  status    PlatformAdministratorStatus @default(ACTIVE)
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("platform_administrators")
}

model InventoryConnection {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @map("tenant_id") @db.Uuid
  dealershipId             String                    @map("dealership_id") @db.Uuid
  name                     String
  connectorType            InventoryConnectorType    @default(MYSQL) @map("connector_type")
  host                     String
  port                     Int                       @default(3306)
  databaseName             String                    @map("database_name")
  username                 String
  credentialCiphertext     String                    @map("credential_ciphertext")
  credentialIv             String                    @map("credential_iv")
  credentialTag            String                    @map("credential_tag")
  credentialReference      String                    @map("credential_reference")
  status                   InventoryConnectionStatus @default(DRAFT)
  tlsEnabled               Boolean                   @default(true) @map("tls_enabled")
  connectTimeoutMs         Int                       @default(5000) @map("connect_timeout_ms")
  queryTimeoutMs           Int                       @default(5000) @map("query_timeout_ms")
  lastTestedAt             DateTime?                 @map("last_tested_at")
  lastSuccessfulConnectionAt DateTime?               @map("last_successful_connection_at")
    configurationRevision    Int                       @default(1) @map("configuration_revision")
    lastTestedRevision       Int?                      @map("last_tested_revision")
  mapping                  Json?
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dealership               Dealership                @relation(fields: [dealershipId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "inventory_connections_dealership_tenant_id_fkey")

  @@unique([dealershipId, name], map: "inventory_connections_dealership_name_key")
  @@unique([dealershipId], map: "inventory_connections_dealership_id_key")
  @@index([tenantId, status], map: "inventory_connections_tenant_status_idx")
  @@index([dealershipId, status], map: "inventory_connections_dealership_status_idx")
  @@map("inventory_connections")
}
